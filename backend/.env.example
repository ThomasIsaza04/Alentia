# Copiar a backend/.env. Nunca subir .env al repositorio.
ENVIRONMENT=development
# Aplicación: rol restringido 'alentia_app' (creado por db/init).
DATABASE_URL=postgresql+psycopg://alentia_app:cambiar_en_env@localhost:5432/alentia
# Migraciones: dueño del esquema.
MIGRATION_DATABASE_URL=postgresql+psycopg://alentia:cambiar_en_env@localhost:5432/alentia
TEST_DATABASE_URL=postgresql+psycopg://alentia:cambiar_en_env@localhost:5432/alentia_test
APP_TEST_DATABASE_URL=postgresql+psycopg://alentia_app:cambiar_en_env@localhost:5432/alentia_test
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]
ENCRYPTION_ACTIVE_KEY_ID=k1
# Generar con: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEYS={"k1":"REEMPLAZAR_CON_CLAVE_GENERADA"}
# Mínimo 32 caracteres. Generar con: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=REEMPLAZAR_CON_SECRETO_LARGO
# Cookies: en desarrollo sobre http usar false; en producción siempre true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
